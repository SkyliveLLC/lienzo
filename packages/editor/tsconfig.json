{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@skylivellc/lienzo-core": [
        "../core/src/index.ts"
      ],
      "@skylivellc/lienzo-core/protocol": [
        "../core/src/protocol.ts"
      ],
      "@skylivellc/lienzo-core/data.json": [
        "./src/core-data.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "dev",
    "test",
    "e2e",
    "*.config.ts"
  ]
}
