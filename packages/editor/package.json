{
  "name": "@skylivellc/lienzo-editor",
  "version": "0.2.0",
  "description": "Visual editor for Lienzo landing pages. A Vue 3 component and a <lienzo-editor> custom element that talk to any backend over the Lienzo protocol.",
  "keywords": [
    "landing-page",
    "page-builder",
    "visual-editor",
    "vue",
    "custom-element",
    "lienzo"
  ],
  "homepage": "https://github.com/SkyliveLLC/lienzo/tree/main/packages/editor#readme",
  "bugs": "https://github.com/SkyliveLLC/lienzo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkyliveLLC/lienzo.git",
    "directory": "packages/editor"
  },
  "license": "MIT",
  "author": "Skylive LLC",
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/standalone/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/types/element.d.ts",
      "import": "./dist/element.js"
    },
    "./standalone": "./dist/standalone/lienzo-editor.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode standalone && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "prepack": "node ../../scripts/copy-notices.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@skylivellc/lienzo-core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
