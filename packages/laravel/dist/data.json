    "url": {
      "kind": "link",
      "prefix": "",
      "requires": "https://"
    },
    "anchor": {
      "kind": "link",
      "prefix": "#",
      "keep": "a-zA-Z0-9_-"
    },
    "page": {
      "kind": "link",
      "prefix": "/",
      "keep": "a-z0-9-",
      "lower": true,
      "trim": "-",
      "base": true
    },
