    "background_opacity": {
      "var": "ba",
      "kind": "num"
    },
    "blur": {
      "var": "blur",
      "kind": "num",
      "skip": 0
    },
    "rotate": {
      "var": "rot",
      "kind": "num",
      "skip": 0
    },
    "flip_x": {
