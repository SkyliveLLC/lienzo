{
  "name": "@skylive/lienzo-core",
  "version": "0.0.0",
  "description": "Document schema and renderer for Lienzo landing pages. No framework required.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.mts",
      "import": "./dist/protocol.mjs"
    },
    "./schema.json": "./dist/schema.json",
    "./data.json": "./dist/data.json",
    "./lienzo.css": "./dist/lienzo.css",
    "./runtime.js": "./dist/runtime.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/assets.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "golden": "node scripts/golden.ts && node scripts/parse-golden.ts",
    "runtime": "node scripts/runtime.ts",
    "render-inputs": "node scripts/render-inputs.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "playwright": "1.63.0",
    "tsdown": "^0.23.0"
  }
}
