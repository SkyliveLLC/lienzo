{
    "name": "skylive/lienzo",
    "description": "Landing page builder for Laravel: a visual editor, a document schema and a native PHP renderer.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Skylive\\Lienzo\\": "packages/laravel/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Skylive\\Lienzo\\Tests\\": "packages/laravel/tests/"
        }
    },
    "scripts": {
        "test": "pest --test-directory=packages/laravel/tests",
        "lint": "pint packages/laravel"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Skylive\\Lienzo\\LienzoServiceProvider"
            ],
            "aliases": {
                "Lienzo": "Skylive\\Lienzo\\Facades\\Lienzo"
            }
        }
    }
}
