{
  "name": "lienzo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "parity": "node scripts/parity/run.ts",
    "golden": "pnpm --filter @skylivellc/lienzo-core golden",
    "sync:php": "node scripts/sync-php-assets.ts",
    "e2e": "pnpm -r --workspace-concurrency=1 e2e",
    "e2e:examples": "pnpm --filter './examples/*' --workspace-concurrency=1 e2e"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
