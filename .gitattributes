# Keep the Composer package to what a Laravel app runs: the PHP sources, config,
# migrations, views and the prebuilt assets in packages/laravel/dist.
/.github export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/docs export-ignore
/examples export-ignore
/fixtures export-ignore
/packages/core export-ignore
/packages/editor export-ignore
/packages/laravel/tests export-ignore
/scripts export-ignore
/package.json export-ignore
/pnpm-lock.yaml export-ignore
/pnpm-workspace.yaml export-ignore
/tsconfig.base.json export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
